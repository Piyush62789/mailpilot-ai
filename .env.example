# ==============================================================================
# MailPilot AI - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
SECRET_KEY=super-secret-mailpilot-key-change-in-production

# AI Engine (Optional Gemini API key for live inference)
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash

# Real Mailbox Configuration - Incoming (IMAP)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.email@gmail.com
IMAP_PASSWORD=your-16-character-app-password

# Real Mailbox Configuration - Outgoing (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
